# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Google Apps Script web app URL that writes leads to the Google Sheet (see docs/lead-sheet-apps-script.gs)
LEAD_WEBHOOK_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Public site URL used in canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://wayfarer.example

# Preview builds only: set to 1 to allow "sample": true entries (shows SAMPLE badges). Never set on production.
NEXT_PUBLIC_SAMPLE_BUILD=
